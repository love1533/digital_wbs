# JIRA Cloud 인증 (generate_wbs.py 사용 시)
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
# GitHub Actions 등 CI에서는 Repository Secrets에 아래 변수를 등록해 사용하세요.

JIRA_URL=https://your-domain.atlassian.net/
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY

# HTML 비밀번호 (선택, 기본값 wbs2026)
# WBS_PASSWORD=your-password
